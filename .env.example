# URL pública del back (Bun + Elysia). Sin diagonal final.
# Desarrollo: el back local. Producción: https://api.evelinedublan.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# Guardia de /admin en el servidor (proxy.ts). Solo tiene sentido cuando front
# y back comparten dominio y el back emite la cookie con COOKIE_DOMINIO.
# En dominios distintos déjalo en "no": la protección la hace el back (401).
ADMIN_GUARD_SERVIDOR=no
